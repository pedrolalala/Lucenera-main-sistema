*.mp4
*.mov
*.avi

# Apresentações pesadas de referência (ex.: lista de fotos do showroom, ~268MB)
*.odp
*.pptx

# Saída local do import de fotos do showroom (SPEC-125): imagens extraídas + CSV
scripts/_saida_showroom/

# Log estruturado por execução do ciclo de sincronização Connect (SPEC-157)
scripts/logs/


